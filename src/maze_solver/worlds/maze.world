    <!-- Камера сверху -->
    <model name="top_camera">
      <static>true</static>
      <pose>1.5 1.5 5.0 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="top_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/camera</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>