    </model>

    <model name="inner4">
      <static>true</static>
      <pose>0.9 2.25 0.15 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.1 0.3</size>
            </box>
          </geometry>
          <material>
