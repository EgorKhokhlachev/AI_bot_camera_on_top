    </model>

    <!-- Красный шар -->
    <model name="red_ball">
      <static>true</static>
      <pose>2.55 0.45 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Зеленые шары -->
    <model name="green_ball1">
      <static>true</static>
      <pose>0.45 0.45 0.08 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
