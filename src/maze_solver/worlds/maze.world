<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="maze_world">

    <gravity>0 0 -9.8</gravity>

    <!-- Обязательная система сенсоров для камеры -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <!-- Освещение -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Пол -->
    <model name="floor">
      <static>true</static>
      <pose>1.5 1.5 0 0 0 0</pose>
      <link name="floor_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 3.0 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.0 3.0 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Внешние стены -->
    <model name="wall_bottom">
      <static>true</static>
      <pose>1.5 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.0 0.1 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="wall_top">
      <static>true</static>
      <pose>1.5 3.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.0 0.1 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>0.0 1.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 3.0 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 3.0 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Правая стена с выходом -->
    <model name="wall_right_bottom">
      <static>true</static>
      <pose>3.0 0.60 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 1.0 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
